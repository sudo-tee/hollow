+// Present through DirectComposition with premultiplied alpha so the desktop
+// shows through transparent pixels. Returns false to fall back to an opaque
+// HWND swapchain.
+_SOKOL_PRIVATE bool _sapp_d3d11_create_composition_swapchain(IDXGIFactory* dxgi_factory) {
+    IDXGIFactory2* factory2 = 0;
+    HMODULE dcomp_dll = 0;
+    IDXGISwapChain1* swap_chain1 = 0;
+    HRESULT hr = _SAPP_COM_METHOD(dxgi_factory, 0, _sapp_com_query_t)(dxgi_factory, _sapp_win32_refiid(_sapp_IID_IDXGIFactory2), (void**)&factory2);
+    if (!SUCCEEDED(hr) || !factory2) {
+        return false;
+    }
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    _sapp_clear(&desc, sizeof(desc));
+    desc.Width = (UINT)(_sapp.framebuffer_width > 0 ? _sapp.framebuffer_width : 1);
+    desc.Height = (UINT)(_sapp.framebuffer_height > 0 ? _sapp.framebuffer_height : 1);
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.Scaling = DXGI_SCALING_STRETCH;
+    desc.SwapEffect = (DXGI_SWAP_EFFECT) _SAPP_DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    desc.AlphaMode = DXGI_ALPHA_MODE_PREMULTIPLIED;
+    #if defined(__cplusplus)
+        hr = factory2->CreateSwapChainForComposition((IUnknown*)_sapp.d3d11.device, &desc, NULL, &swap_chain1);
+    #else
+        hr = factory2->lpVtbl->CreateSwapChainForComposition(factory2, (IUnknown*)_sapp.d3d11.device, &desc, NULL, &swap_chain1);
+    #endif
+    _SAPP_SAFE_RELEASE(factory2);
+    if (!SUCCEEDED(hr) || !swap_chain1) {
+        return false;
+    }
+
+    dcomp_dll = LoadLibraryA("dcomp.dll");
+    _sapp_DCompositionCreateDevice_t create_device = dcomp_dll ? (_sapp_DCompositionCreateDevice_t)(void*)GetProcAddress(dcomp_dll, "DCompositionCreateDevice") : 0;
+    bool ok = create_device &&
+        SUCCEEDED(create_device((IDXGIDevice*)_sapp.d3d11.dxgi_device, _sapp_win32_refiid(_sapp_IID_IDCompositionDevice), &_sapp.d3d11.dcomp_device));
+    ok = ok && SUCCEEDED(_SAPP_COM_METHOD(_sapp.d3d11.dcomp_device, _SAPP_DCOMP_DEVICE_CREATE_TARGET_FOR_HWND, _sapp_dcomp_create_target_t)(_sapp.d3d11.dcomp_device, _sapp.win32.hwnd, TRUE, &_sapp.d3d11.dcomp_target));
+    ok = ok && SUCCEEDED(_SAPP_COM_METHOD(_sapp.d3d11.dcomp_device, _SAPP_DCOMP_DEVICE_CREATE_VISUAL, _sapp_dcomp_create_visual_t)(_sapp.d3d11.dcomp_device, &_sapp.d3d11.dcomp_visual));
+    ok = ok && SUCCEEDED(_SAPP_COM_METHOD(_sapp.d3d11.dcomp_visual, _SAPP_DCOMP_VISUAL_SET_CONTENT, _sapp_dcomp_set_t)(_sapp.d3d11.dcomp_visual, swap_chain1));
+    ok = ok && SUCCEEDED(_SAPP_COM_METHOD(_sapp.d3d11.dcomp_target, _SAPP_DCOMP_TARGET_SET_ROOT, _sapp_dcomp_set_t)(_sapp.d3d11.dcomp_target, _sapp.d3d11.dcomp_visual));
+    ok = ok && SUCCEEDED(_SAPP_COM_METHOD(_sapp.d3d11.dcomp_device, _SAPP_DCOMP_DEVICE_COMMIT, _sapp_dcomp_commit_t)(_sapp.d3d11.dcomp_device));
+    if (!ok) {
+        _sapp_com_release(&_sapp.d3d11.dcomp_visual);
+        _sapp_com_release(&_sapp.d3d11.dcomp_target);
+        _sapp_com_release(&_sapp.d3d11.dcomp_device);
+        _SAPP_SAFE_RELEASE(swap_chain1);
+        // dcomp.dll stays loaded: a failed device may still reference it.
+        return false;
+    }
+    _sapp.d3d11.swap_chain = (IDXGISwapChain*)swap_chain1;
+    _sapp.d3d11.swap_chain_desc.BufferCount = desc.BufferCount;
+    _sapp.d3d11.use_dxgi_frame_stats = false;
+    return true;
+}
